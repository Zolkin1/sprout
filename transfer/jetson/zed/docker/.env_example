# Copy to `.env` and edit. Compose reads it only when it CREATES the container; after an
# edit, `docker compose up -d --force-recreate`.
USER=unitree
UID=1000
GID=1000

IMAGE_TAG=jp6.2
DOCKERFILE=Dockerfile.jp6.2
# CONFIRM against the SDK version and JetPack on the device: `cat /etc/nv_tegra_release`.
ZED_IMAGE=stereolabs/zed:4.2-devel-jetson-jp6.2
ZED_REF=23ef4fa709652614d385daa355e917c2ca9ea34f

# MUST match the onboard obelisk graph, or the controller never sees a depth frame and
# simply reports a depth dropout. Read verbatim via env_file -- see docker-compose.yml.
ROS_DOMAIN_ID=2
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp
