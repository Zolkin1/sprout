# Copy to `.env` and edit. Compose reads it only when it CREATES the container; after an
# edit, `docker compose up -d --force-recreate`.
# NOT named USER: `USER` is exported by every login shell, and compose precedence is
# shell > .env, so a `USER: ${USER}` build arg silently takes the HOST login name and
# ignores whatever is set here. Same trap the ROS_DOMAIN_ID note below describes, which
# is why this key is spelled differently rather than just documented.
ZED_USER=unitree
UID=1000
GID=1000

IMAGE_TAG=jp6.2
DOCKERFILE=Dockerfile.jp6.2
# CONFIRM against the SDK version and JetPack on the device: `cat /etc/nv_tegra_release`.
#
# Must match the SDK INSTALLED ON THE HOST, because the GMSL ZED X path is split across the
# boundary: the kernel driver + nvargus-daemon are the host's, only the SDK is the
# container's. zed-box-2 is L4T R36.4.4 with SDK 5.2.3 and GMSL driver 1.4.1.
#
# The `-py-` variant is REQUIRED, not cosmetic: optimize_ai_models.sh imports pyzed, and
# SDK 5.x splits the Python API out of the plain `-devel-` images.
#
# There is no `4.2-devel-jetson-jp6.2`. SDK 4.2's Jetson tags stop at jp6.1.0, and the
# JetPack tags are three-component (`jetson-jp6.2.2`) -- so the old value here could not
# be pulled at all and `docker compose build` died on the first FROM.
ZED_IMAGE=stereolabs/zed:5.2.3-py-devel-l4t-r36.4
ZED_REF=23ef4fa709652614d385daa355e917c2ca9ea34f

# MUST match the onboard obelisk graph, or the controller never sees a depth frame and
# simply reports a depth dropout. Read verbatim via env_file -- see docker-compose.yml.
ROS_DOMAIN_ID=2
RMW_IMPLEMENTATION=rmw_cyclonedds_cpp

# Pin DDS to the WIRED robot network. Without this Cyclone picks one interface from wifi,
# the robot link and the docker/l4t bridges and says "selected arbitrarily" in its own log --
# so Thor<->ZED traffic could land on wifi, or on a bridge that reaches nothing, while both
# boxes look healthy. Read VERBATIM via env_file, like ROS_DOMAIN_ID above. The path is the
# one inside the container; ../config is bind mounted at /opt/zed_config.
CYCLONEDDS_URI=file:///opt/zed_config/cyclonedds.xml
