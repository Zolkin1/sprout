# Copyright 2026 Zachary Olkin. All rights reserved.
#
# Benchmark image for the ONNX deploy path (transfer/deploy/benchmark.py).
#
# Deliberately separate from transfer/obelisk/docker: that image is a full ROS 2 + Obelisk
# build, targets x86, and pins the CPU-only onnxruntime. Benchmarking wants the opposite --
# something small enough to drop on any candidate deploy box, and able to carry a GPU wheel.
#
# Three targets, one wheel source per platform. The repo is BIND-MOUNTED rather than COPYed
# (the same convention as transfer/obelisk/docker/docker-compose.yml), so editing the
# benchmark needs no rebuild.
#
#   cpu     -- x86_64 or aarch64, CPU only.        The System76 Meerkat (no NVIDIA GPU).
#   cuda    -- x86_64 + discrete NVIDIA.           This dev box.
#   jetson  -- aarch64 + integrated NVIDIA (L4T).  Orin now, Thor by changing ORT_WHEEL.
#
# --- build ------------------------------------------------------------------------------
#   docker build -f transfer/deploy/docker/Dockerfile.bench --target cpu  -t fmbench:cpu  .
#   docker build -f transfer/deploy/docker/Dockerfile.bench --target cuda -t fmbench:cuda .
#
#   # Jetson: the wheel is NOT on PyPI -- as of onnxruntime 1.28 PyPI publishes NO aarch64
#   # onnxruntime-gpu wheel at all (x86_64 + Windows only), so `pip install onnxruntime-gpu`
#   # on an L4T box either finds nothing or (on older versions, which DID ship an aarch64
#   # wheel targeting SBSA/Grace with datacenter CUDA) imports fine and reports no CUDA
#   # provider. Take a JetPack-matched build and pin it to the JetPack the box runs
#   # (`cat /etc/nv_tegra_release`), from the index below:
#   #   https://elinux.org/Jetson_Zoo#ONNX_Runtime   |   https://pypi.jetson-ai-lab.io
#   # (the .dev domain in older notes now redirects to .io). Pick the index by BOARD:
#   #   Orin / JP 6.2 = L4T r36.4 = CUDA 12.6 / TRT 10.3 -> jp6/cu126
#   #   Thor / JP 7.x = L4T r38.x = CUDA 13.0           -> sbsa/cu130
#   # There is no `jp7` index and there will not be one: JP7 ships the arm64-SBSA CUDA
#   # packaging, so Thor is served by the same index as Grace. That inverts the warning
#   # above -- on Thor, SBSA is the RIGHT wheel, not the wrong one.
#   # Either a direct wheel URL:
#   docker build -f transfer/deploy/docker/Dockerfile.bench --target jetson \
#       --build-arg L4T_BASE=nvcr.io/nvidia/l4t-jetpack:r36.4.0 \
#       --build-arg ORT_WHEEL=<direct .whl URL> -t fmbench:jetson .
#   # ...or the index, letting pip resolve it (note the +simple/ suffix -- it is a devpi
#   # server, and the bare directory URL is not a PEP 503 index):
#   docker build -f transfer/deploy/docker/Dockerfile.bench --target jetson \
#       --build-arg ORT_INDEX_URL=https://pypi.jetson-ai-lab.io/jp6/cu126/+simple/ -t fmbench:jetson .
#   # L4T_BASE above is the Orin/JP6.2 tag; a Thor build needs the r38 tag matching its
#   # JetPack. VERIFIED so far only bare-metal on Thor (see transfer/requirements.txt), not
#   # as a container build.
#
#   # If building is a hassle, the ZED image already has the whole JetPack CUDA stack, so
#   # `pip3 install <the same wheel>` inside it works as a base too -- and puts the
#   # benchmark next to the thing you want to measure contention against.
#
#   The build FAILS if the installed wheel reports no GPU provider, so a JetPack mismatch
#   surfaces at build time rather than as a plausible-looking CPU measurement.
#
# --- run --------------------------------------------------------------------------------
#   REPO=$(git rev-parse --show-toplevel)
#   docker run --rm -v $REPO:$REPO -w $REPO fmbench:cpu \
#       python3 transfer/deploy/benchmark.py --run_dir logs/rsl_rl/g1/<run> \
#               --threads 1,2,4,0 --json bench_$(hostname)_cpu.json
#
#   docker run --rm --gpus all -v $REPO:$REPO -w $REPO fmbench:cuda \
#       python3 transfer/deploy/benchmark.py --run_dir logs/rsl_rl/g1/<run> \
#               --providers cpu,cuda --json bench_$(hostname)_gpu.json
#
#   # Jetson needs --runtime nvidia (not --gpus) and benefits from --sample-gpu, which
#   # reads tegrastats -- the integrated GPU does not show up in nvidia-smi.
#   docker run --rm --runtime nvidia -v $REPO:$REPO -w $REPO fmbench:jetson \
#       python3 transfer/deploy/benchmark.py --run_dir logs/rsl_rl/g1/<run> \
#               --providers cpu,cuda,trt --sample-gpu --json bench_orin.json
#
# --- before you trust a Jetson number -----------------------------------------------------
#   sudo nvpmodel -q          # which power mode (MAXN / 30W / 15W) is active
#   sudo jetson_clocks        # lock clocks, or the governor makes runs unrepeatable
# The benchmark prints the CPU scaling governor for the same reason on x86: a 'powersave'
# box reads far slower than the same box under 'performance', which would send a
# device comparison the wrong way.
#
# --- the contention question ---------------------------------------------------------------
# On a Jetson the GPU is shared with the ZED depth pipeline, so an idle-GPU number answers
# the wrong question. Run it twice -- once idle, once with the ZED node live
# (transfer/jetson/zed) -- and compare step_worst p99.


# An ARG used in a FROM must be declared BEFORE the first FROM (global scope); declaring it
# next to the jetson stage puts it in that stage's scope, where the FROM cannot see it.
#
# l4t-jetpack carries the full CUDA/cuDNN/TensorRT stack, which is what the ORT GPU wheel
# links against; l4t-base does NOT on JP6 and would need them layered in. Match the tag to
# the board's JetPack (`cat /etc/nv_tegra_release`); r36.4.0 = JP 6.2, the version
# transfer/jetson/zed/docker/Dockerfile.jp6.2 targets. Verified to resolve on nvcr.io:
#   nvcr.io/nvidia/l4t-jetpack:r36.4.0   nvcr.io/nvidia/l4t-jetpack:r36.3.0
#   nvcr.io/nvidia/l4t-cuda:12.6.11-runtime      nvcr.io/nvidia/l4t-base:r36.2.0
# (`nvcr.io/nvidia/l4t-base:r36.4.0` does NOT exist -- l4t-base stopped at r36.2.0.)
ARG L4T_BASE=nvcr.io/nvidia/l4t-jetpack:r36.4.0


# ==========================================================================================
FROM python:3.10-slim AS cpu
# PyPI ships manylinux wheels for both x86_64 and aarch64, so this target covers the
# Meerkat and a CPU-only baseline on the Jetson from the same Dockerfile.
# Pinned to the same minor as the cuda target below: this file exists to COMPARE devices,
# and a CPU row and a GPU row from different onnxruntime minors are not a comparison.
RUN pip install --no-cache-dir numpy onnxruntime==1.22.0
CMD ["python3", "-c", "import onnxruntime as ort; print(ort.__version__, ort.get_available_providers())"]


# ==========================================================================================
FROM nvidia/cuda:12.8.0-runtime-ubuntu22.04 AS cuda
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-pip \
    && rm -rf /var/lib/apt/lists/*
# The [cuda,cudnn] extras pull the nvidia-* wheels ORT needs. They still have to be on the
# loader path at session-creation time: transfer/deploy/tracker_session._preload_gpu_dlls
# calls onnxruntime.preload_dlls() whenever a non-CPU provider is requested, because
# without it ORT fails to load libcublasLt and SILENTLY falls back to CPU.
#
# ==1.22.0, and the pin is load-bearing rather than cautious: 1.28.0's [cuda] extra
# resolves the -cu13 wheels and dies with "libcublasLt.so.13: cannot open shared object
# file" against this CUDA 12.8 base. 1.22.0's extras pin nvidia-*-cu12~=12.0 + cudnn 9.
# Unpinned, this target also silently stopped reproducing the benchmark numbers recorded
# against it. Match transfer/obelisk/docker/requirements.txt when bumping either.
RUN pip3 install --no-cache-dir numpy "onnxruntime-gpu[cuda,cudnn]==1.22.0"
# Assert the GPU wheel got installed. That is all a build can check: get_available_providers()
# is a static property of the wheel, and actually dlopen'ing libonnxruntime_providers_cuda.so
# SEGFAULTS without a GPU (measured: exit 139 in a plain container, 0 under --gpus all -- the
# .so does not link libcuda.so.1, but loading it still reaches the driver). So a CUDA-major
# mismatch cannot be caught here; catch it on first run, where the CMD below prints the
# providers and benchmark.py warns when a row silently fell back to CPU.
RUN python3 -c "\
import onnxruntime as ort; \
p = ort.get_available_providers(); \
assert 'CUDAExecutionProvider' in p, 'CPU-only wheel: %s' % p; print('providers:', p)"
CMD ["python3", "-c", "import onnxruntime as ort; ort.preload_dlls(); print(ort.__version__, ort.get_available_providers())"]


# ==========================================================================================
FROM ${L4T_BASE} AS jetson
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-pip \
    && rm -rf /var/lib/apt/lists/*
# JetPack-matched wheel, supplied at build time -- there is no correct default, and a wrong
# one fails silently rather than loudly. Thor is this same target with a JP7 URL.
ARG ORT_WHEEL
ARG ORT_INDEX_URL
RUN test -n "$ORT_WHEEL" -o -n "$ORT_INDEX_URL" || (echo "ERROR: pass ONE of --build-arg ORT_WHEEL=<direct .whl URL> or --build-arg ORT_INDEX_URL=<pip index>; see the header." && false)
RUN pip3 install --no-cache-dir numpy && \
    if [ -n "$ORT_WHEEL" ]; then pip3 install --no-cache-dir "$ORT_WHEEL"; \
    else pip3 install --no-cache-dir --index-url "$ORT_INDEX_URL" onnxruntime-gpu; fi
# Fail the BUILD if the wheel cannot actually see the GPU. A JetPack mismatch otherwise
# imports fine, reports CPU-only, and the benchmark silently measures the wrong thing --
# better to find out here than after a run that looks plausible.
RUN python3 -c "import onnxruntime as ort, sys; p=ort.get_available_providers(); print(p); \
sys.exit(0 if 'CUDAExecutionProvider' in p or 'TensorrtExecutionProvider' in p else 'no GPU provider: wrong wheel for this JetPack')"
# CUDA / cuDNN / TensorRT come from the L4T base image and the nvidia container runtime,
# so there are no extras to install here -- unlike the x86 cuda target above.
CMD ["python3", "-c", "import onnxruntime as ort; print(ort.__version__, ort.get_available_providers())"]
